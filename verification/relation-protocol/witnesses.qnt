// These deterministic runs export successful ITF traces. Each run invokes the
// same transition actions used by exhaustive checking; expect checks the goal.
module single_witnesses {
  import protocol(ACTORS = Set(0), CAP = 1, SCRIPTED = false, MUTATION = "none").* from "./protocol"

  run normalSuccessTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "ok"))
    .then(commit(0)).then(notify(0, false)).expect(safety and outcome.get(0) == "ok" and calls.get(0) == 1)
  run emptyResultTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "empty"))
    .then(commit(0)).then(notify(0, false)).expect(safety and outcome.get(0) == "empty" and counts.get(0) == 1)
  run allFilteredTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "filtered"))
    .then(commit(0)).then(notify(0, false)).expect(safety and outcome.get(0) == "empty" and relations.get(0) == 0)
  run noCandidatesTest = initMode("no_candidates").then(admit(0))
    .expect(safety and phase.get(0) == "waiting_nodes" and calls.get(0) == 0)
  run reserveFailureTest = initMode("reserve_fail").then(admit(0))
    .expect(safety and phase.get(0) == "reserve_failed" and counts.get(0) == 0 and calls.get(0) == 0)
  run protocolLimitTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "protocol"))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "protocol"))
    .expect(safety and outcome.get(0) == "failed" and counts.get(0) == 2)
  run protocolThenSuccessTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "protocol"))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "ok"))
    .then(commit(0)).then(notify(0, false)).expect(safety and outcome.get(0) == "ok" and counts.get(0) == 2)
  run transientLimitTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "transient"))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "transient"))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "transient"))
    .expect(safety and outcome.get(0) == "failed" and counts.get(0) == 3)
  run transientThenSuccessTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "transient"))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "ok"))
    .then(commit(0)).then(notify(0, false)).expect(safety and outcome.get(0) == "ok" and counts.get(0) == 2)
  run mixedProtocolThenTransientTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "protocol"))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "transient"))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "ok"))
    .then(commit(0)).then(notify(0, false)).expect(safety and outcome.get(0) == "ok" and counts.get(0) == 3)
  // The protocol cutoff uses total window attempts, not a separate protocol counter.
  run mixedTransientThenProtocolTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "transient"))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "protocol"))
    .expect(safety and outcome.get(0) == "failed" and counts.get(0) == 2)
  run authTerminalTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "auth"))
    .expect(safety and outcome.get(0) == "failed" and counts.get(0) == 1)
  run rateLimitThenSuccessTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "rate_limit"))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "ok"))
    .then(commit(0)).then(notify(0, false)).expect(safety and outcome.get(0) == "ok" and counts.get(0) == 2)
  run retryAfterOverLimitTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "rate_limit_long"))
    .expect(safety and outcome.get(0) == "failed" and counts.get(0) == 1)
  run unexpectedTerminalTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "unexpected"))
    .expect(safety and outcome.get(0) == "failed" and counts.get(0) == 1)
  run commitFailureTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "ok"))
    .then(commitFail(0)).expect(safety and outcome.get(0) == "failed" and counts.get(0) == 1 and relations.get(0) == 0)
  run notifyFailureTest = initMode("valid").then(admit(0)).then(send(0)).then(respond(0, "ok"))
    .then(commit(0)).then(notify(0, true)).expect(safety and outcome.get(0) == "ok" and relations.get(0) == 1 and counts.get(0) == 1)
}
module multi_cap1_witnesses {
  import protocol(ACTORS = Set(0, 1, 2), CAP = 1, SCRIPTED = true, MUTATION = "none").* from "./protocol"
  run laterWindowDuringRetryTest = initMode("valid")
    .then(admit(0)).then(send(0)).then(respond(0, "protocol"))
    .then(admit(2)).then(send(2)).then(respond(2, "filtered")).then(commit(2)).then(notify(2, false))
    .then(advanceTime).then(admit(0)).then(send(0)).then(respond(0, "ok")).then(commit(0)).then(notify(0, false))
    .then(admit(1)).then(send(1)).then(respond(1, "transient")).then(advanceTime)
    .then(admit(1)).then(send(1)).then(respond(1, "empty")).then(commit(1)).then(notify(1, false))
    .expect(safety and allTerminal and calls == Map(0 -> 2, 1 -> 2, 2 -> 1))
  run sequentialThreeTest = initMode("valid")
    .then(admit(0)).then(send(0)).then(respond(0, "protocol")).then(advanceTime)
    .then(admit(0)).then(send(0)).then(respond(0, "ok")).then(commit(0)).then(notify(0, false))
    .then(admit(1)).then(send(1)).then(respond(1, "transient")).then(advanceTime)
    .then(admit(1)).then(send(1)).then(respond(1, "empty")).then(commit(1)).then(notify(1, false))
    .then(admit(2)).then(send(2)).then(respond(2, "filtered")).then(commit(2)).then(notify(2, false))
    .expect(safety and allTerminal and calls == Map(0 -> 2, 1 -> 2, 2 -> 1) and relations == Map(0 -> 1, 1 -> 0, 2 -> 0))
}
module multi_cap2_witnesses {
  import protocol(ACTORS = Set(0, 1, 2), CAP = 2, SCRIPTED = true, MUTATION = "none").* from "./protocol"
  run interleavedThreeTest = initMode("valid")
    .then(admit(0)).then(admit(1)).expect(activeCount == 2)
    .then(send(0)).then(send(1)).then(respond(1, "transient"))
    .then(admit(2)).then(send(2)).then(respond(2, "filtered")).then(commit(2)).then(notify(2, false))
    .then(respond(0, "protocol")).then(advanceTime)
    .then(admit(1)).then(admit(0)).then(send(1)).then(send(0))
    .then(respond(0, "ok")).then(respond(1, "empty"))
    .then(commit(1)).then(commit(0)).then(notify(0, true)).then(notify(1, false))
    .expect(safety and allTerminal and calls == Map(0 -> 2, 1 -> 2, 2 -> 1) and relations == Map(0 -> 1, 1 -> 0, 2 -> 0))
}
