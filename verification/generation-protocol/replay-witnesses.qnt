  run cancelLateSuccessTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0)).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedActiveCount == 0 and observedCallbackCount.get(0) == 0 and observedBusiness.get(0) == Set())
  run cancelLateFailureTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0)).then(responseReplay(0, "failed"))
    .expect(ReplaySafety and observedOutcome.get(0) == "none" and observedReserved.get(0) == 1)
  run oldResponseWhileNewActiveTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0)).then(newGenerationReplay(0))
    .then(permitReplay).then(reserveReplay(0)).then(sendReplay(1)).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedActiveOwner.get(0) == 1 and observedReserved.get(1) == 1 and observedBusiness.get(0) == Set())
  run outOfOrderGenerationTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0)).then(newGenerationReplay(0))
    .then(permitReplay).then(reserveReplay(0)).then(sendReplay(1)).then(responseReplay(1, "ok")).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedBusiness.get(0) == Set(1) and observedCallbackCount.get(1) == 1 and observedCallbackCount.get(0) == 0)
  run duplicateSettlementTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(responseReplay(0, "ok"))
    .then(duplicateReplay(0)).then(duplicateReplay(0))
    .expect(ReplaySafety and observedBusiness.get(0) == Set(0) and observedCallbackCount.get(0) == 1 and observedCalls.get(0) == 1)
  run deleteLateRestartTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(deleteReplay(0))
    .then(responseReplay(0, "ok")).then(restartReplay).then(duplicateReplay(0))
    .expect(ReplaySafety and not(observedPresent.get(0)) and observedBusiness.get(0) == Set() and observedUsage.get(0) == "none")
