// Native refinement witnesses. Original broad-model witnesses remain unchanged.
module replay_relation_single_witnesses {
  import replay_generation(REPLAY_ACTORS = Set(0), REPLAY_CAP = 1, REPLAY_PROTOCOL = "relation").* from "./replay-refinement"
  run normalSuccessTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedBusiness.get(0) == Set(0) and observedCallbackCount.get(0) == 1)
  run normalFailureTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(responseReplay(0, "failed"))
    .expect(ReplaySafety and observedOutcome.get(0) == "failed" and observedBusiness.get(0) == Set())
  run cancelLateSuccessTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0)).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedActiveCount == 0 and observedCallbackCount.get(0) == 0 and observedBusiness.get(0) == Set())
  run cancelLateFailureTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0)).then(responseReplay(0, "failed"))
    .expect(ReplaySafety and observedOutcome.get(0) == "none" and observedReserved.get(0) == 1)
  run oldResponseWhileNewActiveTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0)).then(newGenerationReplay(0))
    .then(permitReplay).then(reserveReplay(0)).then(sendReplay(1)).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedActiveOwner.get(0) == 1 and observedReserved.get(1) == 1 and observedBusiness.get(0) == Set())
  run outOfOrderGenerationTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0)).then(newGenerationReplay(0))
    .then(permitReplay).then(reserveReplay(0)).then(sendReplay(1)).then(responseReplay(1, "ok")).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedBusiness.get(0) == Set(1) and observedCallbackCount.get(1) == 1 and observedCallbackCount.get(0) == 0)
  run duplicateSettlementTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(responseReplay(0, "ok"))
    .then(duplicateReplay(0)).then(duplicateReplay(0))
    .expect(ReplaySafety and observedBusiness.get(0) == Set(0) and observedCallbackCount.get(0) == 1 and observedCalls.get(0) == 1)
  run deleteLateRestartTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(deleteReplay(0))
    .then(responseReplay(0, "ok")).then(restartReplay).then(duplicateReplay(0))
    .expect(ReplaySafety and not(observedPresent.get(0)) and observedBusiness.get(0) == Set() and observedUsage.get(0) == "none")
  run deleteRestartLateTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(deleteReplay(0))
    .then(restartReplay).then(responseReplay(0, "failed"))
    .expect(ReplaySafety and not(observedPresent.get(0)) and observedReserved.get(0) == 0 and observedActiveCount == 0)
  run successfulRestartTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(responseReplay(0, "ok")).then(restartReplay)
    .expect(ReplaySafety and observedBusiness.get(0) == Set(0) and observedReserved.get(0) == 1 and observedRestartCount == 1)
  run repeatedLateUsageIsAttemptScopedTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(usageReplay(0))
    .then(cancelReplay(0)).then(newGenerationReplay(0)).then(permitReplay).then(reserveReplay(0)).then(sendReplay(1))
    .then(usageReplay(0)).then(usageReplay(0)).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedUsage.get(0) == "late_response" and observedUsage.get(1) == "none" and observedActiveOwner.get(0) == 1)

}
module replay_relation_multi_cap1_witnesses {
  import replay_generation(REPLAY_ACTORS = Set(0, 1, 2), REPLAY_CAP = 1, REPLAY_PROTOCOL = "relation").* from "./replay-refinement"
  run cancelReleasesSlotTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedActiveOwner.get(1) == 2 and observedPhysical.get(2) == "inflight" and observedBusiness.get(1) == Set())
  run otherListeningSurvivesDeleteTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(deleteReplay(0))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(0, "failed")).then(responseReplay(2, "ok"))
    .then(restartReplay)
    .expect(ReplaySafety and observedBusiness.get(1) == Set(2) and observedPresent.get(1) and not(observedPresent.get(0)))
  run threeTasksProgressTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(responseReplay(0, "ok"))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(2, "failed"))
    .then(permitReplay).then(reserveReplay(2)).then(sendReplay(4)).then(responseReplay(4, "ok"))
    .expect(ReplaySafety and observedBusiness.get(0) == Set(0) and observedBusiness.get(2) == Set(4) and observedOutcome.get(1) == "failed")
}
module replay_relation_multi_cap2_witnesses {
  import replay_generation(REPLAY_ACTORS = Set(0, 1, 2), REPLAY_CAP = 2, REPLAY_PROTOCOL = "relation").* from "./replay-refinement"
  run cancelReleasesSlotTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedActiveOwner.get(1) == 2 and observedPhysical.get(2) == "inflight" and observedBusiness.get(1) == Set())
  run otherListeningSurvivesDeleteTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(deleteReplay(0))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(0, "failed")).then(responseReplay(2, "ok"))
    .then(restartReplay)
    .expect(ReplaySafety and observedBusiness.get(1) == Set(2) and observedPresent.get(1) and not(observedPresent.get(0)))
  run threeTasksProgressTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(responseReplay(0, "ok"))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(2, "failed"))
    .then(permitReplay).then(reserveReplay(2)).then(sendReplay(4)).then(responseReplay(4, "ok"))
    .expect(ReplaySafety and observedBusiness.get(0) == Set(0) and observedBusiness.get(2) == Set(4) and observedOutcome.get(1) == "failed")
  run oldPhysicalExceedsLocalCapacityTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(permitReplay).then(reserveReplay(1)).then(sendReplay(2))
    .then(cancelReplay(0)).then(newGenerationReplay(0)).then(permitReplay).then(reserveReplay(0)).then(sendReplay(1))
    .expect(ReplaySafety and observedActiveCount == 2 and observedREQUESTS.filter(r => observedPhysical.get(r) == "inflight").size() == 3)
  run twoListeningOutOfOrderTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(permitReplay).then(reserveReplay(1)).then(sendReplay(2))
    .then(responseReplay(2, "ok")).then(responseReplay(0, "failed"))
    .expect(ReplaySafety and observedBusiness.get(1) == Set(2) and observedOutcome.get(0) == "failed")
}
module replay_knowledge_single_witnesses {
  import replay_generation(REPLAY_ACTORS = Set(0), REPLAY_CAP = 1, REPLAY_PROTOCOL = "knowledge").* from "./replay-refinement"
