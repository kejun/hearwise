    .then(restartReplay).then(responseReplay(0, "failed"))
    .expect(ReplaySafety and not(observedPresent.get(0)) and observedReserved.get(0) == 0 and observedActiveCount == 0)
  run successfulRestartTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(responseReplay(0, "ok")).then(restartReplay)
    .expect(ReplaySafety and observedBusiness.get(0) == Set(0) and observedReserved.get(0) == 1 and observedRestartCount == 1)
}
module replay_knowledge_multi_cap1_witnesses {
  import replay_generation(REPLAY_ACTORS = Set(0, 1, 2), REPLAY_CAP = 1, REPLAY_PROTOCOL = "knowledge").* from "./replay-refinement"
  run cancelReleasesSlotTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(0, "ok"))
    .expect(ReplaySafety and observedActiveOwner.get(1) == 2 and observedPhysical.get(2) == "inflight" and observedBusiness.get(1) == Set())
  run otherListeningSurvivesDeleteTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(deleteReplay(0))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(0, "failed")).then(responseReplay(2, "ok"))
    .then(restartReplay)
    .expect(ReplaySafety and observedBusiness.get(1) == Set(2) and observedPresent.get(1) and not(observedPresent.get(0)))
  run threeTasksProgressTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(responseReplay(0, "ok"))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(2, "failed"))
    .then(permitReplay).then(reserveReplay(2)).then(sendReplay(4)).then(responseReplay(4, "ok"))
    .expect(ReplaySafety and observedBusiness.get(0) == Set(0) and observedBusiness.get(2) == Set(4) and observedOutcome.get(1) == "failed")
  run cancelDoesNotCancelPendingJobTest = ReplayInit.then(permitReplay).then(reserveReplay(0)).then(sendReplay(0)).then(cancelReplay(0))
    .then(permitReplay).then(reserveReplay(1)).then(sendReplay(2)).then(responseReplay(2, "failed"))
    .then(permitReplay).then(reserveReplay(2)).then(sendReplay(4)).then(responseReplay(0, "ok")).then(responseReplay(4, "ok"))
    .expect(ReplaySafety and observedGeneration.get(2) == 0 and observedBusiness.get(2) == Set(4) and observedReserved.get(0) == 1)

}
