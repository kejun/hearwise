module relation_single_witnesses {
  import generation_protocol(ACTORS = Set(0), CAP = 1, PROTOCOL = "relation", MUTATION = "none", TRACE = true).* from "./protocol"
  run normalSuccessTest = init.then(reserve(0)).then(send(0)).then(respond(0, "ok"))
    .expect(safety and business.get(0) == Set(0) and callbackCount.get(0) == 1)
  run normalFailureTest = init.then(reserve(0)).then(send(0)).then(respond(0, "failed"))
    .expect(safety and outcome.get(0) == "failed" and business.get(0) == Set())
  run cancelLateSuccessTest = init.then(reserve(0)).then(send(0)).then(cancel(0)).then(respond(0, "ok"))
    .expect(safety and activeCount == 0 and callbackCount.get(0) == 0 and business.get(0) == Set())
  run cancelLateFailureTest = init.then(reserve(0)).then(send(0)).then(cancel(0)).then(respond(0, "failed"))
    .expect(safety and outcome.get(0) == "none" and reserved.get(0) == 1)
  run oldResponseWhileNewActiveTest = init.then(reserve(0)).then(send(0)).then(cancel(0)).then(newGeneration(0))
    .then(reserve(0)).then(send(1)).then(respond(0, "ok"))
    .expect(safety and activeOwner.get(0) == 1 and reserved.get(1) == 1 and business.get(0) == Set())
  run outOfOrderGenerationTest = init.then(reserve(0)).then(send(0)).then(cancel(0)).then(newGeneration(0))
    .then(reserve(0)).then(send(1)).then(respond(1, "ok")).then(respond(0, "ok"))
    .expect(safety and business.get(0) == Set(1) and callbackCount.get(1) == 1 and callbackCount.get(0) == 0)
  run duplicateSettlementTest = init.then(reserve(0)).then(send(0)).then(respond(0, "ok"))
    .then(duplicate(0)).then(duplicate(0))
    .expect(safety and business.get(0) == Set(0) and callbackCount.get(0) == 1 and calls.get(0) == 1)
  run deleteLateRestartTest = init.then(reserve(0)).then(send(0)).then(deleteListening(0))
    .then(respond(0, "ok")).then(restart).then(duplicate(0))
    .expect(safety and not(present.get(0)) and business.get(0) == Set() and usage.get(0) == "none")
  run deleteRestartLateTest = init.then(reserve(0)).then(send(0)).then(deleteListening(0))
    .then(restart).then(respond(0, "failed"))
    .expect(safety and not(present.get(0)) and reserved.get(0) == 0 and activeCount == 0)
  run successfulRestartTest = init.then(reserve(0)).then(send(0)).then(respond(0, "ok")).then(restart)
    .expect(safety and business.get(0) == Set(0) and reserved.get(0) == 1 and restartCount == 1)
  run repeatedLateUsageIsAttemptScopedTest = init.then(reserve(0)).then(send(0)).then(reportUsage(0))
    .then(cancel(0)).then(newGeneration(0)).then(reserve(0)).then(send(1))
    .then(reportUsage(0)).then(reportUsage(0)).then(respond(0, "ok"))
    .expect(safety and usage.get(0) == "late_response" and usage.get(1) == "none" and activeOwner.get(0) == 1)

}
module relation_multi_cap1_witnesses {
  import generation_protocol(ACTORS = Set(0, 1, 2), CAP = 1, PROTOCOL = "relation", MUTATION = "none", TRACE = true).* from "./protocol"
  run cancelReleasesSlotTest = init.then(reserve(0)).then(send(0)).then(cancel(0))
    .then(reserve(1)).then(send(2)).then(respond(0, "ok"))
    .expect(safety and activeOwner.get(1) == 2 and physical.get(2) == "inflight" and business.get(1) == Set())
  run otherListeningSurvivesDeleteTest = init.then(reserve(0)).then(send(0)).then(deleteListening(0))
    .then(reserve(1)).then(send(2)).then(respond(0, "failed")).then(respond(2, "ok"))
    .then(restart)
    .expect(safety and business.get(1) == Set(2) and present.get(1) and not(present.get(0)))
  run threeTasksProgressTest = init.then(reserve(0)).then(send(0)).then(respond(0, "ok"))
    .then(reserve(1)).then(send(2)).then(respond(2, "failed"))
    .then(reserve(2)).then(send(4)).then(respond(4, "ok"))
    .expect(safety and business.get(0) == Set(0) and business.get(2) == Set(4) and outcome.get(1) == "failed")
}
module relation_multi_cap2_witnesses {
  import generation_protocol(ACTORS = Set(0, 1, 2), CAP = 2, PROTOCOL = "relation", MUTATION = "none", TRACE = true).* from "./protocol"
  run cancelReleasesSlotTest = init.then(reserve(0)).then(send(0)).then(cancel(0))
    .then(reserve(1)).then(send(2)).then(respond(0, "ok"))
    .expect(safety and activeOwner.get(1) == 2 and physical.get(2) == "inflight" and business.get(1) == Set())
  run otherListeningSurvivesDeleteTest = init.then(reserve(0)).then(send(0)).then(deleteListening(0))
    .then(reserve(1)).then(send(2)).then(respond(0, "failed")).then(respond(2, "ok"))
    .then(restart)
    .expect(safety and business.get(1) == Set(2) and present.get(1) and not(present.get(0)))
  run threeTasksProgressTest = init.then(reserve(0)).then(send(0)).then(respond(0, "ok"))
    .then(reserve(1)).then(send(2)).then(respond(2, "failed"))
    .then(reserve(2)).then(send(4)).then(respond(4, "ok"))
    .expect(safety and business.get(0) == Set(0) and business.get(2) == Set(4) and outcome.get(1) == "failed")
  run oldPhysicalExceedsLocalCapacityTest = init.then(reserve(0)).then(send(0)).then(reserve(1)).then(send(2))
    .then(cancel(0)).then(newGeneration(0)).then(reserve(0)).then(send(1))
    .expect(safety and activeCount == 2 and REQUESTS.filter(r => physical.get(r) == "inflight").size() == 3)
  run twoListeningOutOfOrderTest = init.then(reserve(0)).then(send(0)).then(reserve(1)).then(send(2))
    .then(respond(2, "ok")).then(respond(0, "failed"))
    .expect(safety and business.get(1) == Set(2) and outcome.get(0) == "failed")
}
