// Reachable traces exported for replay through the actual HTTP server and SQLite.
// These actions are identical to those checked by TLC and bounded Apalache.
module single_witnesses {
  import protocol(TOKENS = Set(0), MAX_GENERATIONS = 2, MAX_WRITES = 2, MAX_RESTARTS = 1, MAX_FAILURES = 1, MUTATION = "none").* from "./protocol"

  run normalSuccessTest = init.then(upload(0, "append")).then(commit(0, "append", 1, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(0, 1))
  run replaceSuccessTest = init.then(upload(0, "replace")).then(commit(0, "replace", 1, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(1))
  run duplicateAppendTest = init.then(upload(0, "append")).then(commit(0, "append", 1, false))
    .then(commit(0, "append", 1, false)).expect(safety and lastHTTPStatus == 410 and businessIds == Set(0, 1))
  run duplicateReplaceTest = init.then(upload(0, "replace")).then(commit(0, "replace", 1, false))
    .then(commit(0, "replace", 1, false)).expect(safety and lastHTTPStatus == 410 and businessIds == Set(1))
  run invalidModeTest = init.then(upload(0, "append")).then(commit(0, "invalid", 1, false))
    .expect(safety and lastHTTPStatus == 400 and lastHTTPCode == "INVALID_IMPORT_MODE" and businessIds == Set(0))
  run modeMismatchTest = init.then(upload(0, "replace")).then(commit(0, "append", 1, false))
    .expect(safety and lastHTTPStatus == 409 and lastHTTPCode == "IMPORT_PREVIEW_STALE" and businessIds == Set(0))
  run unissuedGenerationTest = init.then(upload(0, "append")).then(commit(0, "append", 0, false))
    .expect(safety and lastHTTPStatus == 409 and businessIds == Set(0))
  run rotatedPreviewStaleTest = init.then(upload(0, "append")).then(preview(0, "append"))
    .then(commit(0, "append", 1, false)).expect(safety and lastHTTPStatus == 409 and businessIds == Set(0))
  run modeSwitchRecoveryTest = init.then(upload(0, "replace")).then(preview(0, "append"))
    .then(commit(0, "replace", 1, false)).expect(lastHTTPStatus == 409)
    .then(commit(0, "append", 2, false)).expect(safety and lastHTTPStatus == 200 and businessIds == Set(0, 1))
  run sameConnectionStaleTest = init.then(upload(0, "append")).then(write("same"))
    .then(commit(0, "append", 1, false)).expect(safety and lastHTTPStatus == 409 and businessIds == Set(0))
  run staleOtherConnectionTest = init.then(upload(0, "append")).then(write("other"))
    .then(commit(0, "append", 1, false)).expect(safety and lastHTTPStatus == 409 and businessIds == Set(0))
  run bothConnectionsStaleTest = init.then(upload(0, "append")).then(write("same")).then(write("other"))
    .then(commit(0, "append", 1, false)).expect(safety and lastHTTPStatus == 409 and writes == 2 and businessIds == Set(0))
  run sameWriteRecoveryAppendTest = init.then(upload(0, "append")).then(write("same"))
    .then(commit(0, "append", 1, false)).expect(lastHTTPStatus == 409)
    .then(preview(0, "append")).then(commit(0, "append", 2, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(0, 1))
  run otherWriteRecoveryReplaceTest = init.then(upload(0, "replace")).then(write("other"))
    .then(commit(0, "replace", 1, false)).expect(lastHTTPStatus == 409)
    .then(preview(0, "replace")).then(commit(0, "replace", 2, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(1))
  run expiredCommitTest = init.then(upload(0, "append")).then(expire(0)).then(commit(0, "append", 1, false))
    .expect(safety and lastHTTPStatus == 410 and lastHTTPCode == "IMPORT_EXPIRED" and businessIds == Set(0))
  run expiredPreviewTest = init.then(upload(0, "replace")).then(expire(0)).then(preview(0, "replace"))
    .expect(safety and lastHTTPStatus == 410 and clientGeneration.get(0) == 1 and businessIds == Set(0))
  run previewDoesNotRenewExpiryTest = init.then(upload(0, "append")).then(preview(0, "append"))
    .then(expire(0)).then(commit(0, "append", 2, false))
    .expect(safety and lastHTTPStatus == 410 and businessIds == Set(0))
  run restartCommitTest = init.then(upload(0, "replace")).then(restart).then(commit(0, "replace", 1, false))
    .expect(safety and lastHTTPStatus == 410 and businessIds == Set(0))
  run restartPreviewTest = init.then(upload(0, "append")).then(restart).then(preview(0, "append"))
    .expect(safety and lastHTTPStatus == 410 and clientGeneration.get(0) == 1 and businessIds == Set(0))
  run appendRollbackTest = init.then(upload(0, "append")).then(commit(0, "append", 1, true))
    .expect(safety and lastHTTPStatus == 409 and lastHTTPCode == "APPEND_FAILED" and businessIds == Set(0) and consumptionCount.get(0) == 0)
  run replaceRollbackTest = init.then(upload(0, "replace")).then(commit(0, "replace", 1, true))
    .expect(safety and lastHTTPStatus == 500 and lastHTTPCode == "RESTORE_FAILED" and businessIds == Set(0) and consumptionCount.get(0) == 0)
  run rollbackRequiresPreviewRecoveryTest = init.then(upload(0, "append")).then(commit(0, "append", 1, true))
    .then(commit(0, "append", 1, false)).expect(lastHTTPCode == "IMPORT_PREVIEW_STALE")
    .then(preview(0, "append")).then(commit(0, "append", 2, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(0, 1) and consumptionCount.get(0) == 1)
  run cleanupStutterTest = init.then(upload(0, "replace")).then(commit(0, "replace", 1, false))
    .then(cleanup(0)).then(stutter).expect(safety and lastHTTPStatus == 200 and businessIds == Set(1) and consumptionCount.get(0) == 1)
  run restartPreservesImportedDataTest = init.then(upload(0, "append")).then(commit(0, "append", 1, false))
    .then(restart).then(commit(0, "append", 1, false)).expect(safety and lastHTTPStatus == 410 and businessIds == Set(0, 1))
}

module two_tokens_witnesses {
  import protocol(TOKENS = Set(0, 1), MAX_GENERATIONS = 2, MAX_WRITES = 2, MAX_RESTARTS = 1, MAX_FAILURES = 1, MUTATION = "none").* from "./protocol"

  run appendInvalidatesOtherPreviewTest = init.then(upload(0, "append")).then(upload(1, "append"))
    .then(commit(0, "append", 1, false)).then(commit(1, "append", 1, false))
    .expect(lastHTTPStatus == 409 and businessIds == Set(0, 1))
    .then(preview(1, "append")).then(commit(1, "append", 2, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(0, 1, 2))
  run replaceInvalidatesOtherPreviewTest = init.then(upload(0, "replace")).then(upload(1, "append"))
    .then(commit(0, "replace", 1, false)).then(commit(1, "append", 1, false))
    .expect(lastHTTPStatus == 409 and businessIds == Set(1))
    .then(preview(1, "append")).then(commit(1, "append", 2, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(1, 2))
  run appendThenReplaceRecoveryTest = init.then(upload(0, "append")).then(upload(1, "replace"))
    .then(commit(0, "append", 1, false)).then(commit(1, "replace", 1, false))
    .expect(lastHTTPStatus == 409).then(preview(1, "replace")).then(commit(1, "replace", 2, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(2))
  run expiryIsTokenLocalTest = init.then(upload(0, "append")).then(upload(1, "append"))
    .then(expire(0)).then(commit(0, "append", 1, false)).expect(lastHTTPStatus == 410)
    .then(commit(1, "append", 1, false)).expect(safety and lastHTTPStatus == 200 and businessIds == Set(0, 2))
  run restartThenFreshUploadTest = init.then(upload(0, "replace")).then(restart)
    .then(commit(0, "replace", 1, false)).expect(lastHTTPStatus == 410)
    .then(upload(1, "append")).then(commit(1, "append", 1, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(0, 2))
  run rollbackInvalidatesOtherPreviewTest = init.then(upload(0, "append")).then(upload(1, "replace"))
    .then(commit(0, "append", 1, true)).then(commit(1, "replace", 1, false))
    .expect(lastHTTPCode == "IMPORT_PREVIEW_STALE" and businessIds == Set(0))
    .then(preview(1, "replace")).then(commit(1, "replace", 2, false))
    .expect(safety and lastHTTPStatus == 200 and businessIds == Set(2))
}
