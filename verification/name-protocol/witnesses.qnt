module independent_witnesses {
  import name_protocol(MODE = "independent", MUTATION = "none").* from "./protocol"
  run successTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok")).then(deliver(0)).then(refresh(0))
    .expect(safety and state.name == 1 and state.receipt.get(0) == "succeeded")
  run noOpTest = init.then(prepare(0, "same")).then(send(0)).then(transaction(0, "ok")).then(deliver(0))
    .expect(safety and state.revision == 0 and state.changes == 0 and state.receipt.get(0) == "succeeded")
  run noOpSkipsAssociatedFaultTest = init.then(prepare(0, "same")).then(send(0)).then(transaction(0, "associated_fail")).then(deliver(0))
    .expect(safety and state.txResult.get(0) == "committed" and state.revision == 0 and state.receipt.get(0) == "succeeded")
  run concurrentConflictTest = init.then(prepare(0, "new")).then(prepare(1, "new")).then(send(0)).then(send(1))
    .then(transaction(0, "ok")).then(transaction(1, "ok")).then(deliver(1)).then(refresh(1))
    .expect(safety and state.name == 1 and state.txResult.get(1) == "revision_conflict" and state.requests.get(1) == 1)
  run revisionRecheckTest = init.then(prepare(0, "new")).then(send(0)).then(backgroundChange("revision")).then(transaction(0, "ok"))
    .expect(safety and state.txResult.get(0) == "revision_conflict" and state.name == 0 and state.receipt.get(0) == "none")
  run anchorRecheckTest = init.then(prepare(0, "new")).then(send(0)).then(backgroundChange("anchor")).then(transaction(0, "ok"))
    .expect(safety and state.txResult.get(0) == "anchor_conflict" and state.revision == 0 and state.receipt.get(0) == "none")
  run associatedRollbackTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "associated_fail")).then(deliver(0)).then(refresh(0))
    .expect(safety and state.name == 0 and state.revision == 0 and state.receipt.get(0) == "none")
  run receiptRollbackTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "receipt_fail")).then(deliver(0))
    .expect(safety and state.changes == 0 and state.receipt.get(0) == "none")
  run lostReceiptRecoveryTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok")).then(loseResponse(0, "lost"))
    .then(lookup(0, "ok")).then(refresh(0)).expect(safety and state.loadedName.get(0) == 1 and state.reply.get(0) == "receipt" and state.requests.get(0) == 1)
  run unknownReopenTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok")).then(loseResponse(0, "proxy502"))
    .then(lookup(0, "unavailable")).expect(state.phase.get(0) == "unknown")
    .then(refresh(0)).expect(safety and state.loadedName.get(0) == 1 and state.requests.get(0) == 1)
  run rollbackUnknownTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "receipt_fail")).then(loseResponse(0, "proxy502"))
    .then(lookup(0, "ok")).expect(safety and state.phase.get(0) == "unknown" and state.receipt.get(0) == "none")
  run cancelledTest = init.then(prepare(0, "new")).then(cancel(0)).then(refresh(0))
    .expect(safety and state.requests.get(0) == 0 and state.changes == 0)
  run lateResponseTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok"))
    .then(prepare(1, "new")).then(send(1)).then(transaction(1, "ok")).then(deliver(1)).then(deliver(0)).then(refresh(0))
    .expect(safety and state.name == 2 and state.loadedName.get(0) == 2 and state.loadedRevision.get(0) == 2)
}
module reuse_witnesses {
  import name_protocol(MODE = "reuse", MUTATION = "none").* from "./protocol"
  run exactReplayTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok")).then(deliver(0))
    .then(prepare(1, "exact")).then(send(1)).then(transaction(1, "ok")).then(deliver(1))
    .expect(safety and state.txResult.get(1) == "duplicate" and state.changes == 1 and state.commits.get(0) == 1)
  run receiptPrecedesRevisionTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok"))
    .then(backgroundChange("revision")).then(prepare(1, "exact")).then(send(1)).then(transaction(1, "ok"))
    .expect(safety and state.txResult.get(1) == "duplicate" and state.revision == 2 and state.receiptCommitRevision.get(0) == 1)
  run receiptPrecedesAnchorTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok"))
    .then(backgroundChange("anchor")).then(prepare(1, "exact")).then(send(1)).then(transaction(1, "ok"))
    .expect(safety and state.txResult.get(1) == "duplicate" and not(state.anchorValid) and state.changes == 1)
  run rawFingerprintConflictTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok"))
    .then(prepare(1, "raw_mismatch")).then(send(1)).then(transaction(1, "ok")).then(deliver(1))
    .expect(safety and state.txResult.get(1) == "fingerprint_conflict" and state.reply.get(1) == "conflict")
  run revisionFingerprintConflictTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok"))
    .then(prepare(1, "revision_mismatch")).then(send(1)).then(transaction(1, "ok"))
    .expect(safety and state.txResult.get(1) == "fingerprint_conflict" and state.receiptInputRevision.get(0) == 0)
  run explicitReplayAfterLostResponseTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok"))
    .then(loseResponse(0, "lost")).then(lookup(0, "unavailable"))
    .then(prepare(1, "exact")).then(send(1)).then(transaction(1, "ok")).then(deliver(1))
    .expect(safety and state.txResult.get(1) == "duplicate" and state.requests.get(0) == 1 and state.requests.get(1) == 1 and state.changes == 1)
  run explicitReplayAfterRollbackTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "receipt_fail"))
    .then(loseResponse(0, "lost")).then(lookup(0, "ok"))
    .then(prepare(1, "exact")).then(send(1)).then(transaction(1, "ok")).then(deliver(1))
    .expect(safety and state.txResult.get(1) == "committed" and state.receiptOwner.get(0) == 1 and state.changes == 1)
  run duplicateInFlightTest = init.then(prepare(0, "new")).then(send(0)).then(prepare(1, "exact")).then(send(1))
    .then(transaction(1, "ok")).then(transaction(0, "ok"))
    .expect(safety and state.txResult.get(0) == "duplicate" and state.txResult.get(1) == "committed" and state.commits.get(0) == 1)
  run mismatchedReceiptLookupTest = init.then(prepare(0, "new")).then(send(0)).then(transaction(0, "ok"))
    .then(prepare(1, "raw_mismatch")).then(send(1)).then(transaction(1, "ok")).then(loseResponse(1, "proxy502"))
    .then(lookup(1, "ok")).expect(safety and state.txResult.get(1) == "fingerprint_conflict" and state.reply.get(1) == "receipt")
}
