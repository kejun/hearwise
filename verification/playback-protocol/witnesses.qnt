module single_witnesses {
  import protocol(OWNERS = Set(1), MAX_PCM = 2, CONTROL_ABA = false, TRACK_ACTIONS = true, MUTATION = "none").* from "./protocol"
  run fullTextSuccessTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(pcm(1)).then(complete(1)).then(pcm(1)).then(complete(1))
    .then(consume(1)).then(settled(1)).expect(safety and active == 0 and played.get(1) == 2)
  run pausedInFlightTest = init.then(start("A", false, 1)).then(unlock(1)).then(pause)
    .then(pcm(1)).then(complete(1)).then(consume(1))
    .expect(safety and accepted.get(1) == 1 and consumed.get(1) == 0 and paused)
  run resumeCompletesTextTest = init.then(start("A", true, 1)).then(unlock(1))
    .then(resume).then(resumeComplete(1)).then(pcm(1)).then(complete(1))
    .then(pcm(1)).then(complete(1)).then(consume(1)).then(settled(1))
    .expect(safety and played.get(1) == 2)
  run pauseCancelsResumeTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(pause).then(resume).then(pause).then(resumeComplete(1))
    .expect(safety and paused and playerPaused.get(1) and not(resuming))
  run stopCancelsResumeTest = init.then(start("A", true, 1)).then(unlock(1))
    .then(resume).then(stop).then(resumeComplete(1)).expect(safety and active == 0)
  run incompleteSecondFrameTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(pcm(1)).then(complete(1)).then(pcm(1)).then(consume(1))
    .then(complete(1)).then(consume(1)).then(settled(1)).expect(safety and consumed.get(1) == 4)
  run wrongEpochIgnoredTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(frame(1, "wrong-epoch")).expect(safety and active == 1 and received.get(1) == 0)
  run reorderedFrameRejectedTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(frame(1, "reordered")).expect(safety and active == 0)
  run interleavedFrameRejectedTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(frame(1, "interleaved")).expect(safety and active == 0)
  run malformedFrameRejectedTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(frame(1, "malformed")).expect(safety and active == 0)
  run duplicateFrameRejectedTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(pcm(1)).then(frame(1, "duplicate")).expect(safety and active == 0)
  run currentSocketErrorTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(late(1, "socket-error")).expect(safety and active == 0)
}
// Wider witness domain is deliberately separate from the MAX_PCM=1 isolation
// exhaustive configuration. These fixed traces do not extend that TLC claim.
module isolation_witnesses {
  import protocol(OWNERS = Set(1, 2, 3), MAX_PCM = 2, CONTROL_ABA = false, TRACK_ACTIONS = true, MUTATION = "none").* from "./protocol"
  run normalSuccessTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(start("A", false, 1)).then(unlock(2)).then(start("A", false, 1)).then(unlock(3))
    .then(late(1, "suspended")).expect(safety and active == 3 and not(paused) and epoch.get(1) == epoch.get(3))
  run pausedSeekResumeTest = init.then(start("A", false, 1)).then(unlock(1)).then(pause)
    .then(pcm(1)).then(complete(1)).then(seek(2)).then(unlock(2))
    .then(consume(2)).then(resume).then(resumeComplete(2))
    .then(pcm(2)).then(complete(2)).then(consume(2)).then(settled(2))
    .expect(safety and played.get(2) == 1 and accepted.get(2) == 1)
  run oldProviderAfterSwitchTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(start("B", false, 1)).then(unlock(2)).then(pcm(1)).then(complete(1))
    .then(late(1, "close")).then(late(1, "socket-error")).then(late(1, "suspended")).then(late(1, "error"))
    .then(frame(1, "malformed")).then(pcm(2)).then(complete(2)).then(pcm(2)).then(complete(2))
    .then(consume(2)).then(settled(2)).expect(safety and played.get(2) == 2 and frames.get(1) == 0 and epoch.get(1) == epoch.get(2))
  run lateUnlockTest = init.then(start("A", false, 1)).then(start("B", false, 1)).then(unlock(2))
    .then(unlock(1)).expect(safety and active == 2 and not(unlocked.get(1)))
  run lateSettlementTest = init.then(start("A", false, 1)).then(unlock(1))
    .then(pcm(1)).then(complete(1)).then(pcm(1)).then(complete(1)).then(consume(1))
    .then(start("B", false, 1)).then(unlock(2)).then(settled(1)).expect(safety and active == 2)
  run switchCancelsResumeTest = init.then(start("A", true, 1)).then(unlock(1)).then(resume)
    .then(start("B", false, 1)).then(unlock(2)).then(resumeComplete(1)).expect(safety and active == 2 and not(paused))
  run switchThenRecoverTest = init.then(start("A", false, 1)).then(unlock(1)).then(switchRecord("B"))
    .then(start("B", false, 2)).then(unlock(2)).then(pcm(2)).then(complete(2)).then(consume(2)).then(settled(2))
    .expect(safety and accepted.get(2) == 1 and played.get(2) == 1)
}
